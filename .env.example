# Server
PORT=3000
NODE_ENV=development

# MongoDB — use the platform-infra compose stack for local dev
# docker compose -f ../platform-infra/docker-compose.yml up -d mongo
MONGO_URI=mongodb://localhost:27017/notifications?replicaSet=rs0

# RabbitMQ — choreography consumers (order-confirmed/-cancelled, payment-succeeded/-failed)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis — notification hot layer (unread counter INCR/DECR, recent list LPUSH/LTRIM, pub/sub)
REDIS_URL=redis://localhost:6379

# Auth — Cognito
# Set AUTH_DISABLED=true locally when you don't have a Cognito pool
AUTH_DISABLED=false
# https://cognito-idp.{region}.amazonaws.com/{userPoolId}
COGNITO_ISSUER=
# App client ID (aud claim in the id_token)
COGNITO_AUDIENCE=

# Observability — OpenTelemetry
# Leave blank to use ConsoleSpanExporter (prints to stdout) for local dev
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=notification-service
